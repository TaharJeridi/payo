ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
POSTGRES_DB=payflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://payflow:payflow@localhost:5432/payflow

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

CHECKOUT_SUCCESS_URL=http://localhost:8000/payments/demo/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:8000/payments/demo/cancel
CHECKOUT_MAX_QUANTITY=10
# Per merchant, per minute. 0 disables the limit.
CHECKOUT_RATE_LIMIT_PER_MINUTE=10
# Lifetime requested for each Stripe Checkout Session (Stripe allows 30 min - 24 h).
# It is also the window in which a client retry can still create a session after a timeout.
CHECKOUT_SESSION_TTL_SECONDS=7200
# How long a request may be "creating" before a retry with the same key can take over.
CHECKOUT_CREATION_LEASE_SECONDS=120

# Reconciliation of non-final payments (docker compose service "reconciler").
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_BATCH_SIZE=100
RECONCILE_OPEN_FIRST_CHECK_SECONDS=900
RECONCILE_BACKOFF_BASE_SECONDS=60
RECONCILE_BACKOFF_MAX_SECONDS=21600

# Enables the demo pages /payments/demo/success|cancel used as Checkout return URLs.
# Defaults to false when unset and is always ignored when ENVIRONMENT=production.
DEMO_ENDPOINTS_ENABLED=true

# RAG: Qwen through Ollama running natively on the host, embeddings stored in Qdrant.
#   ollama pull qwen2.5:7b-instruct && ollama pull bge-m3
# Outside Docker the api reaches them on localhost; docker compose overrides both
# (host.docker.internal:11434 for Ollama, the qdrant service for Qdrant).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
# bge-m3 is multilingual (Italian questions on English docs); nomic-embed-text is English-centric
# and scored 0/6 on Italian documentation questions in the evaluation (see README).
OLLAMA_EMBED_MODEL=bge-m3
# Task prefixes default to what the model was trained with (nomic: "search_query: "/"search_document: ",
# bge-m3: none). Set them only to override. Each model gets its own Qdrant collection
# (<QDRANT_COLLECTION>__<model>); switching model re-indexes everything.
# OLLAMA_EMBED_QUERY_PREFIX=
# OLLAMA_EMBED_DOCUMENT_PREFIX=
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=payflow_rag
RAG_TOP_K=5
# Max documentation chunks when the question is about a payment.
RAG_MAX_DOC_CHUNKS=2
# Cosine cut-off below which the LLM is not called. Calibrated for bge-m3; re-run the evaluation if you change model.
RAG_MIN_SCORE=0.48
# SQL-first assistant phases (all on by default; switched off only to measure the baseline).
RAG_DOCUMENT_FACTS=true
RAG_SQL_LOOKUP=true
RAG_SQL_AGGREGATES=true
RAG_RATE_LIMIT_PER_MINUTE=20
RAG_INDEX_INTERVAL_SECONDS=300
