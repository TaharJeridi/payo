ENVIRONMENT=development
LOG_LEVEL=INFO

POSTGRES_USER=payflow
POSTGRES_PASSWORD=payflow
POSTGRES_DB=payflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://payflow:payflow@localhost:5432/payflow

STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

CHECKOUT_SUCCESS_URL=http://localhost:8000/payments/demo/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:8000/payments/demo/cancel
CHECKOUT_MAX_QUANTITY=10
# Per client IP, per minute. 0 disables the limit.
CHECKOUT_RATE_LIMIT_PER_MINUTE=10

# Enables GET /payments (demo listing). Defaults to false when unset.
DEMO_ENDPOINTS_ENABLED=true
